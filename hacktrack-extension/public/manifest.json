{
  "manifest_version": 3,
  "name": "HackTrack",
  "version": "1.0.0",
  "description": "AI-powered tracker for hackathons, internships, jobs, deadlines, tasks, reminders, and updates from Gmail.",
  "permissions": [
    "identity",
    "storage",
    "alarms",
    "sidePanel"
  ],
  "oauth2": {
    "client_id": "152112116957-vru5k1j0a32tf9l0d86bs1k6tjj36ejf.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "HackTrack",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
